# Copy to .env and fill in real values. .env itself is gitignored.

# --- Neo4j -------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-pick-a-real-password

# --- File access (save-as-copy / save-overwrite-original) ---------------
# Host directory bind-mounted into api-gateway at /data/scl-files.
# Defaults to this repo's own Resources/ folder for local dev.
SCD_FILES_HOST_DIR=./Resources

# --- LLM provider flexibility (used from Phase 2 onward) -----------------
LLM_PROVIDER=anthropic
LLM_MODEL=anthropic-default
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
LITELLM_MASTER_KEY=sk-local-dev-master-key
